# STT 引擎選擇：whisper_api | faster_whisper
STT_ENGINE=faster_whisper

# 若使用 OpenAI Whisper API（雲端），填入 key
OPENAI_API_KEY=your_openai_api_key_here

# Faster-Whisper 本地模型大小：tiny | base | small | medium | large-v3
WHISPER_MODEL_SIZE=base

# Brain Layer API 位址（角色 B）
BRAIN_API_URL=http://localhost:8001/brain/process
